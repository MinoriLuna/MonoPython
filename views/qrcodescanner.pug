extends layout

block content
    .qrcontainer
        link(rel="stylesheet", href="/css/qrcode.css")
        p Scan the question's QR Code here:
        div(id="reader" style="width:300px;height:300px;margin: 0 auto; border-radius: 10px; background-color:#f5f5f5")
        a.btn(href="/ongoing-lobby") Back to Lobby
        script(src="/js/html5-qrcode.min.js")
        script.
            function onScanSuccess(decodedText, decodedResult) {
                // Get the current domain
                var currentDomain = window.location.origin;

                // Redirect to the new URL with the domain included
                window.location.href = currentDomain + "/" + decodedText;

                html5QrcodeScanner.clear();
                // ^ this will stop the scanner (video feed) and clear the scan area.
            }

            var html5QrcodeScanner = new Html5QrcodeScanner(
                "reader", { fps: 10, qrbox: { width: 250, height: 250 } });
            html5QrcodeScanner.render(onScanSuccess);